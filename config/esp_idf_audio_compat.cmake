# Patch the pinned esp-audio-player 1.1.0 in the build tree, preserving managed
# component checksums. Remove this when the upstream bounded copy is fixed.
include_guard(GLOBAL)

function(board_fix_audio_stream_name)
    idf_component_get_property(player_lib chmorgan__esp-audio-player COMPONENT_LIB)
    idf_component_get_property(player_dir chmorgan__esp-audio-player COMPONENT_DIR)
    set(original "${player_dir}/audio_mixer.cpp")
    file(READ "${original}" source)
    set(old "strncpy(stream->name, cfg->name, sizeof(stream->name) - 1);")
    set(new "const size_t name_len = strnlen(cfg->name, sizeof(stream->name) - 1);\n        memcpy(stream->name, cfg->name, name_len);")
    string(FIND "${source}" "${old}" offset)
    if(offset EQUAL -1)
        message(FATAL_ERROR "esp-audio-player name-copy patch no longer matches; review the pinned dependency")
    endif()
    string(REPLACE "${old}" "${new}" patched "${source}")
    # stream is calloc-initialized, and the original final NUL assignment stays.
    set(output "${CMAKE_BINARY_DIR}/ws_patched/esp-audio-player/audio_mixer.cpp")
    get_filename_component(output_dir "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_dir}")
    set(previous "")
    if(EXISTS "${output}")
        file(READ "${output}" previous)
    endif()
    if(NOT previous STREQUAL patched)
        file(WRITE "${output}" "${patched}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")

    get_target_property(sources ${player_lib} SOURCES)
    set(replaced FALSE)
    set(updated_sources "")
    foreach(source_file IN LISTS sources)
        get_filename_component(absolute "${source_file}" ABSOLUTE BASE_DIR "${player_dir}")
        if(absolute STREQUAL original)
            list(APPEND updated_sources "${output}")
            set(replaced TRUE)
        else()
            list(APPEND updated_sources "${source_file}")
        endif()
    endforeach()
    if(NOT replaced)
        message(FATAL_ERROR "esp-audio-player audio_mixer.cpp target source not found")
    endif()
    set_property(TARGET ${player_lib} PROPERTY SOURCES "${updated_sources}")
    # The relocated mixer still includes the vendor's private audio_instance.h.
    target_include_directories(${player_lib} PRIVATE "${player_dir}")
endfunction()

board_fix_audio_stream_name()
